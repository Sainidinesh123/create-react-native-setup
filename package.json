{
  "name": "create-react-native-setup",
  "version": "1.2.0",
  "description": "Single-command React Native project bootstrapper with compatible package installs, Firebase/notification setup, native app icon and splash screen generation, and automated setup",
  "type": "module",
  "bin": {
    "create-react-native-setup": "bin/create-react-native-setup.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "catalogs",
    "README.md"
  ],
  "scripts": {
    "start": "node ./bin/create-react-native-setup.js",
    "test": "node --test test/",
    "create-react-native-setup": "node ./bin/create-react-native-setup.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react-native",
    "cli",
    "scaffold",
    "bootstrap",
    "app-icon",
    "splash-screen",
    "create-react-native-setup"
  ],
  "license": "MIT",
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "semver": "^7.7.2",
    "sharp": "^0.35.3"
  }
}
