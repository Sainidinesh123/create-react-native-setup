{
  "name": "create-react-native-setup",
  "version": "1.2.7",
  "description": "Create React Native App CLI — bare RN project generator with Firebase, FCM push, app icons, splash screen & starter packages",
  "type": "module",
  "bin": {
    "create-react-native-setup": "bin/create-react-native-setup.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "catalogs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node ./bin/create-react-native-setup.js",
    "test": "node --test test/",
    "create-react-native-setup": "node ./bin/create-react-native-setup.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "react-native",
    "react-native-cli",
    "create-react-native-app",
    "react-native-template",
    "react-native-starter",
    "react-native-boilerplate",
    "react-native-bootstrap",
    "react-native-setup",
    "bare-react-native",
    "project-generator",
    "starter-kit",
    "scaffold",
    "bootstrap",
    "cli",
    "npx",
    "android",
    "ios",
    "firebase",
    "react-native-firebase",
    "fcm",
    "push-notifications",
    "react-native-push-notification",
    "app-icon",
    "splash-screen",
    "react-native-splash-screen",
    "react-native-bootsplash",
    "create-react-native-setup"
  ],
  "author": {
    "name": "Sainidinesh123",
